# LiveKit Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret

# Core LLM: Primary (NVIDIA NIM API - Llama 3.3 70B)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Core LLM: Secondary Cloud Backup (Gemini Flash)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Deepgram (STT with Flux endpointing - Single Authority)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Cartesia (TTS Sonic - ~90ms ultra-low latency voice)
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# Tavily AI Web Research (with URL citations)
TAVILY_API_KEY=your-tavily-api-key

# PostgreSQL on OCI (Hyderabad) with pgvector
PG_HOST=your-oci-postgres-host
PG_PORT=5432
PG_DATABASE=navi_db
PG_USER=navi_user
PG_PASSWORD=your-secure-password

# Offline Fallback Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx

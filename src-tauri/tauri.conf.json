{
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "com.chowdary.jarvis",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "J.A.R.V.I.S. // STARK HOLOGRAPHIC CONSOLE",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "center": true,
        "fullscreen": false,
        "maximized": true,
        "visible": true,
        "backgroundColor": "#030712"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Machine learning models & large audio assets (>100MB rejected by GitHub)
models/
*.onnx
*.bin
*.mp3

# Python virtual environments & bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Runtime Data, Logs & Offline Queues
data/cache/*
!data/cache/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/documents/*
!data/documents/.gitkeep
data/uploads/
*.jsonl

# Lockfile deduplication (npm is primary)
pnpm-lock.yaml
